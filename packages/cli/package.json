{
  "name": "@xomda/cli",
  "version": "0.0.3",
  "private": true,
  "description": "CLI for xomda code generation",
  "keywords": [
    "xomda",
    "cli",
    "codegen"
  ],
  "author": "Joris Aerts, 3611758+JorisAerts@users.noreply.github.com",
  "type": "module",
  "license": "MIT",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -b && tsc -b tsconfig.test.json",
