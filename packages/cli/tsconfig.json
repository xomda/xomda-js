{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": "node_modules/.cache/tsconfig.tsbuildinfo",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist",
    "paths": {},
    "rootDir": "src"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "**/__tests__/**"],
  "references": [
    {
      "path": "../core"
    },
    {
      "path": "../model"
    },
    {
      "path": "../template"
    },
    {
      "path": "../util"
    }
  ]
}
