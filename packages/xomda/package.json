{
  "name": "xomda",
  "version": "0.0.3",
  "private": true,
  "description": "Bundle harness for the published `xomda` npm package",
  "author": "Joris Aerts, 3611758+JorisAerts@users.noreply.github.com",
  "type": "module",
  "license": "MIT",
  "main": "src/index.ts",
  "bin": {
    "xomda": "dist/cli.js"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepare": "vite build",
    "build": "vite build",
    "build:publish": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/build.ts",
    "test:tarball-cypress": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/tarball-cypress.ts",
    "typecheck": "tsc -b && tsc -p scripts/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@trpc/server": "11.18.0",
    "@xomda/cli": "workspace:*",
    "@xomda/core": "workspace:*",
    "@xomda/model": "workspace:*",
    "@xomda/node": "workspace:*",
    "@xomda/template": "workspace:*",
    "@xomda/util": "workspace:*",
    "commander": "15.0.0",
    "picocolors": "1.1.1"
  },
  "devDependencies": {
    "@types/node": "25.9.2",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vite-plugin-dts": "5.0.2",
    "vitest": "4.1.8"
  }
}
