{
  "name": "@xomda/node",
  "version": "0.0.3",
  "private": true,
  "description": "Node.js server for xomda",
  "keywords": [
    "xomda",
    "node"
  ],
  "author": "Joris Aerts, 3611758+JorisAerts@users.noreply.github.com",
  "type": "module",
  "license": "MIT",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts --cwd ../..",
    "start": "tsx src/main.ts --cwd ../..",
    "build": "tsc",
    "typecheck": "tsc -b && tsc -b tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@trpc/server": "11.17.0",
    "@xomda/model": "workspace:*",
    "@xomda/util": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "tsx": "4.22.4"
  }
}
