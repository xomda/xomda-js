{
  "name": "@xomda/demo-vue-blog",
  "version": "0.0.3",
  "private": true,
  "description": "xomda Vue 3 demo — small Vite SPA that consumes the Zod schemas xomda generates from a Blog domain model. Generation is driven by the XomdaPlugin Vite plugin.",
  "type": "module",
  "scripts": {
    "model": "tsx scripts/build-model.ts",
    "predev": "pnpm model",
    "prebuild": "pnpm model",
    "generate": "pnpm model && xomda generate --output output",
    "dev": "vite --configLoader runner",
    "build": "vite build --configLoader runner",
    "preview": "vite preview --configLoader runner",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "vue": "3.5.35",
    "xomda": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "25.9.2",
    "@vitejs/plugin-vue-jsx": "5.1.5",
    "@vue/test-utils": "2.4.11",
    "happy-dom": "20.11.1",
    "tsx": "4.22.4",
    "unplugin-xomda": "workspace:*",
    "vite": "8.0.16",
    "vitest": "4.1.8"
  }
}
